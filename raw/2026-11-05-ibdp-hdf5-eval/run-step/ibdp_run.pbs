#!/bin/bash
#PBS -N cae_ibdp_run
#PBS -l select=1
#PBS -l walltime=00:45:00
#PBS -l filesystems=home:flare
#PBS -q debug
#PBS -A IOWarp
#PBS -o /home/hyoklee/wrp/run/cae_ibdp_run.out
#PBS -e /home/hyoklee/wrp/run/cae_ibdp_run.err
# End-to-end check of the OMNI run: step against a live CLIO runtime.
set -o pipefail
WORK=/lus/flare/projects/IOWarp/hyoklee
BIN=${WORK}/build_cae_http/bin
export OMNI_RUN_E2E=${WORK}/omni_run_e2e/ibdp
export IBDP_RUN_OUT=${OMNI_RUN_E2E}/out
JOBID=${PBS_JOBID%%.*}
RUN=${OMNI_RUN_E2E}/run_${JOBID:-manual}
mkdir -p "$RUN"; rm -f "$OMNI_RUN_E2E"/out/*
exec > >(tee -a "$RUN/job.log") 2>&1
echo "host=$(hostname) clio-core: $(git -C /home/hyoklee/clio-core.dev log --oneline -1)"
source /opt/aurora/26.26.0/oneapi/compiler/latest/env/vars.sh > /dev/null 2>&1
export CLIO_SERVER_CONF=${RUN}/clio_server.yaml
export CLIO_MEMFD_DIR=/tmp/clio_memfd_${JOBID:-manual}
export CLIO_IPC_MODE=SHM
mkdir -p "$CLIO_MEMFD_DIR"
cat > "$CLIO_SERVER_CONF" <<YAML
memory:
  main_segment_size: auto
  client_data_segment_size: 1GB
networking:
  port: 9437
runtime:
  num_threads: 8
  queue_depth: 1024
compose:
  - mod_name: clio_cae_core
    pool_name: cae_main
    pool_query: local
    pool_id: "400.0"
    next_pool_id: "512.0"
  - mod_name: clio_cte_core
    pool_name: cte_main
    pool_query: local
    pool_id: "512.0"
    storage:
      - path: "ram::ibdp_ram"
        bdev_type: "ram"
        capacity_limit: "8GB"
        score: 1.0
    dpe:
      dpe_type: "max_bw"
YAML
export CTP_LOG_LEVEL=info
"${BIN}/clio_run" start --fresh --disk "${RUN}/data" --no-viz > "${RUN}/runtime.log" 2>&1 &
RPID=$!
trap 'timeout 60 "${BIN}/clio_run" stop >> "${RUN}/runtime.log" 2>&1; sleep 2; kill -9 $RPID 2>/dev/null; rm -rf "$CLIO_MEMFD_DIR"' EXIT
for _ in $(seq 1 90); do "${BIN}/clio_run" status > /dev/null 2>&1 && break; sleep 2; done
"${BIN}/clio_run" status > /dev/null 2>&1 || { echo "runtime not up"; tail -20 "${RUN}/runtime.log"; exit 1; }
pass=0 fail=0
check() { if eval "$2"; then echo "PASS: $1"; pass=$((pass+1)); else echo "FAIL: $1"; fail=$((fail+1)); fi; }
SGY=/lus/flare/projects/IOWarp/hyoklee/h5eval/sgy/Porosity-NN-Depth.sgy
H5=$IBDP_RUN_OUT/Porosity-NN-Depth.h5

# Wait until tag $1 holds $2 bytes in chunk_* blobs; print the bytes stored and
# the seconds since $3.
wait_tag() {
  local tag=$1 want=$2 t0=$3 tid c0 n have
  for _ in $(seq 1 600); do
    tid=$("${BIN}/cte_search" "$tag" 'chunk_0' --since 2h --format table 2>/dev/null | grep -oE '\([0-9]+,[0-9]+\)' | head -1 | tr -d '()' | tr ',' '.')
    if [ -n "$tid" ]; then
      c0=$("${BIN}/cte_search" "$tid" chunk_0 --blob-info 2>/dev/null | sed -n 's/.*total_size=\([0-9]*\).*/\1/p')
      n=$("${BIN}/cte_search" "$tag" 'chunk_[0-9]+' 2>/dev/null | grep -c 'chunk_')
      last=$("${BIN}/cte_search" "$tid" "chunk_$((n-1))" --blob-info 2>/dev/null | sed -n 's/.*total_size=\([0-9]*\).*/\1/p')
      have=$(( (n-1) * ${c0:-0} + ${last:-0} ))
      if [ "$have" -ge "$want" ]; then echo "$have $((SECONDS - t0)) $n $tid"; return 0; fi
    fi
    sleep 1
  done
  echo "${have:-0} timeout ${n:-0} ${tid:-none}"; return 1
}

echo "=== 1. original SEG-Y"
sgy_bytes=$(stat -c %s "$SGY")
t=$SECONDS
"${BIN}/clio_cae" "$OMNI_RUN_E2E/raw.omni.yaml" > "$RUN/raw.log" 2>&1; rc=$?
check "clio_cae (SEG-Y) exits 0" '[ $rc -eq 0 ]'
read sgy_have sgy_secs sgy_n sgy_tid < <(wait_tag ibdp_porosity_sgy "$sgy_bytes" "$t")
echo "SEG-Y: $sgy_have of $sgy_bytes bytes in $sgy_n blobs (tag $sgy_tid), ${sgy_secs}s"
check "all SEG-Y bytes landed" '[ "$sgy_have" -eq "$sgy_bytes" ]'

echo "=== 2. run: SEG-Y -> HDF5, then ingest"
t=$SECONDS
"${BIN}/clio_cae" "$OMNI_RUN_E2E/h5.omni.yaml" > "$RUN/h5.log" 2>&1; rc=$?
grep -E "sgy2h5|Running transfer|now ingests|ERROR|Traceback" "$RUN/h5.log" | sed 's/\x1b\[[0-9;]*m//g' | sed 's#^.*/src/##'
conv_secs=$((SECONDS - t))
check "clio_cae (run: HDF5) exits 0" '[ $rc -eq 0 ]'
check "run step verified every trace" 'grep -q "traces verified" "$RUN/h5.log"'
h5_bytes=$(stat -c %s "$H5")
read h5_have h5_secs h5_n h5_tid < <(wait_tag ibdp_porosity_h5 "$h5_bytes" "$t")
echo "HDF5: $h5_have of $h5_bytes bytes in $h5_n blobs (tag $h5_tid), ${h5_secs}s including the conversion"
check "all HDF5 bytes landed" '[ "$h5_have" -eq "$h5_bytes" ]'
"${BIN}/cte_search" "$h5_tid" chunk_0 --blob-info 2>/dev/null | grep 'replica 0' | tee "$RUN/h5_head.txt"
check "stored blob starts with the HDF5 signature" 'grep -q "head=\".HDF" "$RUN/h5_head.txt"'

echo "=== 3. what a reader gets: the run_out file vs the SEG-Y"
/home/hyoklee/miniconda3/envs/miv/bin/python -I - "$SGY" "$H5" <<'PY'
import sys, time, os
sys.path.insert(0, '/lus/flare/projects/IOWarp/hyoklee/h5eval/tools/pylib')
import h5py, numpy as np
sgy, h5 = sys.argv[1], sys.argv[2]
def drop(p):
    fd = os.open(p, os.O_RDONLY); os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED); os.close(fd)
with h5py.File(h5, "r") as h:
    ni, nx, ns = h["volume"].shape
    print("HDF5 layout:", h["volume"].shape, h["volume"].chunks, h["volume"].compression, "attrs:", sorted(h.attrs))
tb = 240 + 4 * ns
def segy_z():
    b = np.fromfile(sgy, dtype=np.uint8, offset=3600).reshape(-1, tb)
    return b[:, 240 + 4 * (ns // 2):240 + 4 * (ns // 2) + 4].copy()
def h5_z():
    with h5py.File(h5, "r") as h: return h["volume"][:, :, ns // 2]
for name, fn, p in (("SEG-Y depth slice", segy_z, sgy), ("HDF5 depth slice", h5_z, h5)):
    best = 1e9
    for _ in range(3):
        drop(p); t = time.perf_counter(); fn(); best = min(best, time.perf_counter() - t)
    print(f"{name}: {best:.2f} s")
PY

echo "=== summary"
printf "  %-34s %14s %10s\n" "" "bytes in CTE" "seconds"
printf "  %-34s %14s %10s\n" "original SEG-Y" "$sgy_bytes" "$sgy_secs"
printf "  %-34s %14s %10s\n" "run: -> HDF5 (incl. conversion)" "$h5_bytes" "$h5_secs"
echo "  ratio: $(awk -v a=$sgy_bytes -v b=$h5_bytes 'BEGIN{printf "%.1fx smaller", a/b}')"
echo "=== $pass passed, $fail failed"
[ $fail -eq 0 ]
